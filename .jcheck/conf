[general]
project=bsd-port
repository=bsd-port
jbs=jdk
version=28

[checks]
error=author,committer,reviewers,executable,symlink,whitespace
warning=binary

[census]
version=0
domain=openjdk.org

[checks "whitespace"]
files=.*\.cpp|.*\.hpp|.*\.c|.*\.h|.*\.java|.*\.cc|.*\.hh|.*\.m|.*\.mm|.*\.S|.*\.md|.*\.properties|.*\.gmk|.*\.m4|.*\.ac|Makefile
ignore-tabs=.*\.gmk|Makefile

[checks "reviewers"]
committers=1
ignore=duke

[checks "committer"]
role=committer
